function	script	GRO_AdminUnlock	{
	clear;
	if (getgmlevel() < 99) return;
	mes "[GM / Account Discovery]";
	mes "This operation supports ONLINE accounts only.";
	mes "Enter target account ID (0 for exact online character-name lookup):";
	input .@aid,0,2000000000;
	if (!.@aid) {
		mes "Enter the exact online character name:";
		input .@name$;
		.@aid = getcharid(3,.@name$);
	}
	if (.@aid <= 0) { mes "Account not found online."; return; }
	mes "Enter the numeric destination ID of the dungeon floor:";
	input .@id,1,$@GRO_Count;
	if ($@GRO_Cat[.@id] != 3) { mes "That ID is not an individual dungeon floor."; return; }
	.@choice = select("Grant discovery:Revoke discovery:Cancel");
	if (.@choice == 3) return;
	mes "Target account="+.@aid+", dungeon="+$@GRO_Name$[.@id]+" (ID "+.@id+").";
	if (select("Confirm account change:Cancel") != 1) return;
	if (getgmlevel() < 99) return;
	.@gm = getcharid(3);
	.@gmchar = getcharid(0);
	if (!attachrid(.@aid)) { mes "Target account offline or cannot be attached."; return; }
	.@n = $@GRO_DiscoveryID[.@id] - 1;
	.@mask = 1 << (.@n % 30);
	.@before = ##GRO_Discovered[.@n / 30];
	if (.@choice == 1) ##GRO_Discovered[.@n / 30] |= .@mask;
	else ##GRO_Discovered[.@n / 30] &= ~.@mask;
	.@after = ##GRO_Discovered[.@n / 30];
	// Always switch back to the invoking GM BEFORE any further GM-side actions.
	if (!attachrid(.@gm)) {
		debugmes "GrassRO Warper: failed to reattach original GM account "+.@gm+" after online unlock";
		end;
	}
	if (getcharid(0) != .@gmchar || getgmlevel() < 99) {
		debugmes "GrassRO Warper: GM attachment mismatch on account discovery";
		end;
	}
	callfunc "GRO_LogGM","ACCOUNT_DISCOVERY target="+.@aid+" floor_id="+.@id+" map="+$@GRO_Map$[.@id]+" action="+.@choice+" mask_before="+.@before+" mask_after="+.@after;
	mes "Account discovery updated successfully.";
	return;
}

