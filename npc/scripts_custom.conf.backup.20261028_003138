// Return the canonical map-key ID (same policy/price for duplicated castle maps).
function	script	GRO_Key	{
	.@id = getarg(0);
	if (.@id < 1 || .@id > $@GRO_Count) return 0;
	return $@GRO_Key[.@id];
}

// Account-wide 30-bit bitmask, avoids sign bit and per-floor registries.
function	script	GRO_HasDiscovery	{
	.@id = getarg(0);
	if (.@id < 1 || .@id > $@GRO_Count || $@GRO_Cat[.@id] != 3) return 0;
	.@n = $@GRO_DiscoveryID[.@id] - 1;
	if (.@n < 0) return 0;
	return (##GRO_Discovered[.@n / 30] & (1 << (.@n % 30))) != 0;
}

// Eligibility is dynamically checked against castle ownership, not a cached flag.
function	script	GRO_OwnsRealm	{
	.@realm = getarg(0);
	.@guild = getcharid(2);
	if (.@guild <= 0) return 0;
	switch (.@realm) {
		case 1: .@prefix$ = "prtg_cas0"; break;
		case 2: .@prefix$ = "gefg_cas0"; break;
		case 3: .@prefix$ = "payg_cas0"; break;
		case 4: .@prefix$ = "aldeg_cas0"; break;
		case 5: .@prefix$ = "arug_cas0"; break;
		case 6: .@prefix$ = "schg_cas0"; break;
		default: return 0;
	}
	for (.@n = 1; .@n <= 5; ++.@n) {
		if (GetCastleData(.@prefix$ + .@n, CD_GUILD_ID) == .@guild) return 1;
	}
	return 0;
}

// Access result: 0 OK, 1 map/cell unavailable, 2 restricted, 3 GM-only,
// 4 WoE grounds, 5 guild ownership, 6 undiscovered, 7 MVP policy.
function	script	GRO_Access	{
	.@id = getarg(0);
	if (.@id < 1 || .@id > $@GRO_Count) return 1;
	.@map$ = $@GRO_Map$[.@id];
	.@x = ($GRO_XSet[.@id] ? $GRO_CustomX[.@id] : $@GRO_X[.@id]);
	.@y = ($GRO_XSet[.@id] ? $GRO_CustomY[.@id] : $@GRO_Y[.@id]);
	if (mapname2id(.@map$) < 0 || .@x <= 0 || .@y <= 0 || !checkcell(.@map$,.@x,.@y,cell_chkpass)) return 1;
	.@key = callfunc("GRO_Key",.@id);
	.@policy = $GRO_Policy[.@key];
	if (.@policy < 0 || .@policy > 3 || .@policy == 2) return 2;
	if (.@policy == 3 && getgmlevel() < 99) return 3;
	if ($@GRO_CastleGround[.@id] && $GRO_WoeCastleAllow != 1 && (agitcheck() || agitcheck2() || agitcheck3())) return 4;
	if ($@GRO_Cat[.@id] == 5 && !callfunc("GRO_OwnsRealm",$@GRO_Realm[.@id])) return 5;
	if ($@GRO_Cat[.@id] == 3 && $GRO_DiscoveryBypass != 1 && !callfunc("GRO_HasDiscovery",.@id)) return 6;
	// Only explicit 'Allowed' policies can override global MVP map restrictions.
	if ($GRO_MvpAllow != 1 && $GRO_MvpMap[.@key] && .@policy != 1) return 7;
	return 0;
}

function	script	GRO_Reason	{
	switch (getarg(0)) {
		case 0: return "Available";
		case 1: return "Unavailable / Invalid Cell";
		case 2: return "Restricted";
		case 3: return "GM Only";
		case 4: return "Unavailable During WoE";
		case 5: return "Guild Ownership Required";
		case 6: return "Not Discovered";
		case 7: return "MVP Restriction";
	}
	return "Unknown";
}

function	script	GRO_Fee	{
	.@id = getarg(0);
	if (!$GRO_Pricing || .@id < 1 || .@id > $@GRO_Count) return 0;
	.@key = callfunc("GRO_Key",.@id);
	if ($GRO_FeeSet[.@key]) return $GRO_MapFee[.@key];
	switch ($@GRO_Cat[.@id]) {
		case 1: return $GRO_TownFee;
		case 2: return $GRO_FieldFee;
		case 3: return $GRO_DungeonFee + ($@GRO_Depth[.@id] * $GRO_DepthFee);
		case 4: return $GRO_CastleFee;
		case 5: return $GRO_GuildFee;
	}
	return 0;
}

function	script	GRO_WarpTo	{
	clear;
	.@id = getarg(0);
	.@error = callfunc("GRO_Access",.@id);
	if (.@error) {
		mes "[Grass RO Warper]";
		mes "Cannot warp: ^FF5555" + callfunc("GRO_Reason",.@error) + "^000000.";
		close;
	}
	.@cost = callfunc("GRO_Fee",.@id);
	if (.@cost < 0 || .@cost > 1000000000) {
		mes "[Grass RO Warper]";
		mes "Invalid warp fee. Please contact a GM.";
		close;
	}
	mes "[Grass RO Warper]";
	mes "Destination: ^0055FF" + $@GRO_Name$[.@id] + "^000000";
	mes "Map: " + $@GRO_Map$[.@id];
	mes "Cost: ^005500" + .@cost + " Zeny^000000";
	if (select("Confirm Warp:Cancel") != 1) close;
	// Revalidate after dialog to defeat stale menus, castle changes or GM changes.
	.@error = callfunc("GRO_Access",.@id);
	if (.@error) {
		mes "Destination is no longer available: " + callfunc("GRO_Reason",.@error);
		close;
	}
	.@cost = callfunc("GRO_Fee",.@id);
	if (.@cost < 0 || .@cost > 1000000000 || Zeny < .@cost) {
		mes "Insufficient Zeny or invalid fee.";
		close;
	}
	.@x = ($GRO_XSet[.@id] ? $GRO_CustomX[.@id] : $@GRO_X[.@id]);
	.@y = ($GRO_XSet[.@id] ? $GRO_CustomY[.@id] : $@GRO_Y[.@id]);
	// Last Warp stores the destination ID, never an old price/permission/coordinate.
	GRO_LastID = .@id;
	if (.@cost > 0) Zeny -= .@cost;
	close2;
	warp $@GRO_Map$[.@id],.@x,.@y;
	end;
}

function	script	GRO_Browse	{
	.@cat = getarg(0);
	if (getarraysize(@GRO_List)) deletearray @GRO_List[0],getarraysize(@GRO_List);
	.@count = 0;
	for (.@id = 1; .@id <= $@GRO_Count; ++.@id) {
		if ($@GRO_Cat[.@id] != .@cat) continue;
		.@state = callfunc("GRO_Access",.@id);
		if (.@state == 1 && getgmlevel() < 99) continue;
		if ((.@state == 2 || .@state == 3) && !$GRO_ShowRestricted && getgmlevel() < 99) continue;
		@GRO_List[.@count++] = .@id;
	}
	if (!.@count) {
		clear;
		mes "[Grass RO Warper]";
		mes "No destinations are available in this category.";
		return;
	}
	.@page = 0;
	while (1) {
		clear;
		.@offset = .@page * 14;
		.@last = (.@offset + 14 < .@count ? .@offset + 14 : .@count);
		.@choices$ = "";
		for (.@j = .@offset; .@j < .@last; ++.@j) {
			.@id = @GRO_List[.@j];
			.@status = callfunc("GRO_Access",.@id);
			.@line$ = $@GRO_Name$[.@id];
			if (.@status != 0) .@line$ += " ["+callfunc("GRO_Reason",.@status)+"]";
			else {
				if ($GRO_ShowCounts) .@line$ += " ["+getmapusers($@GRO_Map$[.@id])+"]";
				if (callfunc("GRO_Fee",.@id) > 0) .@line$ += " (" + callfunc("GRO_Fee",.@id) + "z)";
			}
			.@choices$ += .@line$ + ":";
		}
		.@rows = .@last - .@offset;
		.@choices$ += "Previous Page:Next Page:Back";
		mes "[Grass RO Warper]";
		mes "Destinations " + (.@offset+1) + "-" + .@last + " of " + .@count + ".";
		.@pick = select(.@choices$);
		if (.@pick <= .@rows) {
			callfunc "GRO_WarpTo",@GRO_List[.@offset + .@pick - 1];
			return;
		}
		if (.@pick == .@rows+1 && .@page > 0) --.@page;
		else if (.@pick == .@rows+2 && .@last < .@count) ++.@page;
		else if (.@pick == .@rows+3) return;
		clear;
	}
}

function	script	GRO_Progress	{
	.@found = 0;
	.@total = 0;
	for (.@i = 1; .@i <= $@GRO_Count; ++.@i) {
		if ($@GRO_Cat[.@i] != 3 || $GRO_CollectionExcluded[.@i]) continue;
		++.@total;
		if (callfunc("GRO_HasDiscovery",.@i)) ++.@found;
	}
	return (.@found * 10000) + .@total;
}

function	script	GRO_Collection	{
	clear;
	.@value = callfunc("GRO_Progress");
	.@total = .@value % 10000;
	.@found = (.@value - .@total) / 10000;
	mes "[Grass RO Discovery Collection]";
	mes "Account-wide discovered floors: ^0055FF" + .@found + " / " + .@total + "^000000";
	mes "Manual discovery is " + ($GRO_DiscoveryBypass == 1 ? "suspended during soft release." : "active.");
	mes "Reward claiming: ^FF5555DISABLED^000000 (Transaction Safety Ticket D-01).";
	if ($GRO_RewardCount) {
		mes "Published reward versions:";
		for (.@i = 1; .@i <= $GRO_RewardCount; ++.@i) {
			mes "v"+.@i+": "+$GRO_RewardName$[.@i]+($GRO_RewardArchived[.@i] ? " [Archived]" : " [Active]");
		}
	} else mes "No collection reward versions have been published.";
	return;
}

function	script	GRO_LogGM	{
	logmes "GRO_WARPER GM_ACC=" + getcharid(3) + " GM_CHAR=" + getcharid(0) + " NAME=" + strcharinfo(0) + " " + getarg(0);
	return;
}

function	script	GRO_Refresh	{
	// Intended to run on init, GM config change and at the Manila date boundary.
	.@day = (gettimetick(2) + 28800) / 86400;
	for (.@i = 1; .@i <= $@GRO_Count; ++.@i) {
		.@npc$ = $@GRO_Poring$[.@i];
		if (.@npc$ == "") continue;
		.@key = $@GRO_Key[.@i];
		if ($GRO_DiscoveryBypass == 1 || $GRO_Policy[.@key] >= 2 ||
			($GRO_MvpAllow != 1 && $GRO_MvpMap[.@key] && $GRO_Policy[.@key] != 1) ||
			mapname2id($@GRO_Map$[.@i]) < 0) {
			disablenpc .@npc$;
			continue;
		}
		.@x = ($GRO_FixedSet[.@i] ? $GRO_FixedX[.@i] : $@GRO_X[.@i]);
		.@y = ($GRO_FixedSet[.@i] ? $GRO_FixedY[.@i] : $@GRO_Y[.@i]);
		if ($GRO_Randomize) {
			if ($GRO_PoringDay[.@i] != .@day || !checkcell($@GRO_Map$[.@i],$GRO_PoringX[.@i],$GRO_PoringY[.@i],cell_chkpass)) {
				.@valid = 0;
				for (.@a = 0; .@a < 3; ++.@a) {
					.@tx = 0;
					.@ty = 0;
					getfreecell($@GRO_Map$[.@i],.@tx,.@ty);
					if (.@tx > 0 && .@ty > 0 && checkcell($@GRO_Map$[.@i],.@tx,.@ty,cell_chkpass)) {
						.@x = .@tx;
						.@y = .@ty;
						.@valid = 1;
						break;
					}
				}
				if (!.@valid && $GRO_PoringX[.@i] > 0 && $GRO_PoringY[.@i] > 0 && checkcell($@GRO_Map$[.@i],$GRO_PoringX[.@i],$GRO_PoringY[.@i],cell_chkpass)) {
					.@x = $GRO_PoringX[.@i];
					.@y = $GRO_PoringY[.@i];
				}
				if (!.@valid) debugmes "GrassRO Warper: poring random-cell fallback at "+$@GRO_Map$[.@i];
				$GRO_PoringX[.@i] = .@x;
				$GRO_PoringY[.@i] = .@y;
				$GRO_PoringDay[.@i] = .@day;
			}
			.@x = $GRO_PoringX[.@i];
			.@y = $GRO_PoringY[.@i];
		}
		if (.@x > 0 && .@y > 0 && checkcell($@GRO_Map$[.@i],.@x,.@y,cell_chkpass)) {
			movenpc .@npc$,.@x,.@y;
			setnpcdisplay .@npc$,$GRO_PoringSprite;
			enablenpc .@npc$;
		} else disablenpc .@npc$;
	}
	for (.@i = 0; .@i < $@GRO_WarperNpcCount; ++.@i) {
		setnpcdisplay $@GRO_WarperNpc$[.@i],$GRO_MainSprite;
	}
	$@GRO_RefreshDay = .@day;
	return;
}

function	script	GRO_Discover	{
	clear;
	.@id = getarg(0);
	if (.@id < 1 || .@id > $@GRO_Count || $@GRO_Cat[.@id] != 3) end;
	if ($GRO_DiscoveryBypass == 1 || $GRO_Policy[$@GRO_Key[.@id]] >= 2 ||
		($GRO_MvpAllow != 1 && $GRO_MvpMap[$@GRO_Key[.@id]] && $GRO_Policy[$@GRO_Key[.@id]] != 1)) {
		mes "[Strange Poring]";
		mes "Discovery is currently unavailable.";
		close;
	}
	mes "[Strange Poring]";
	if (callfunc("GRO_HasDiscovery",.@id)) {
		mes "You have already discovered ^0055FF" + $@GRO_Name$[.@id] + "^000000.";
		close;
	}
	mes "You found a hidden travel marker on ^0055FF" + $@GRO_Map$[.@id] + "^000000!";
	mes "Unlock this exact floor for every character on your account?";
	if (select("Unlock floor:Leave") != 1) close;
	if ($GRO_DiscoveryBypass == 1 || $GRO_Policy[$@GRO_Key[.@id]] >= 2) close;
	.@n = $@GRO_DiscoveryID[.@id] - 1;
	##GRO_Discovered[.@n / 30] |= 1 << (.@n % 30);
	mes "^008800Discovery unlocked!^000000";
	close;
}

function	script	GRO_Main	{
	while (1) {
		clear;
		mes "[Grass RO Unified Warper]";
		mes "Welcome to Grass RO.";
		.@choice$ = "Last Warp:Towns:Fields:Dungeons:Guild Castles:Guild Dungeons:Discovery Collection / Rewards";
		if (getgmlevel() >= 99) .@choice$ += ":GM Administration";
		.@choice$ += ":Close";
		.@pick = select(.@choice$);
		if (.@pick == 1) {
			if (GRO_LastID < 1 || GRO_LastID > $@GRO_Count) mes "You have no previous Unified Warper destination.";
			else callfunc "GRO_WarpTo",GRO_LastID;
		}
		else if (.@pick >= 2 && .@pick <= 6) callfunc "GRO_Browse",.@pick - 1;
		else if (.@pick == 7) callfunc "GRO_Collection";
		else if (.@pick == 8 && getgmlevel() >= 99) callfunc "GRO_Admin";
		else close;
		next;
		clear;
	}
}

function	script	GRO_ChooseMap	{
	if (getgmlevel() < 99) return 0;
	.@count = getarraysize($@GRO_AdminKeyID);
	.@page = 0;
	while (1) {
		clear;
		.@first = .@page * 14;
		.@last = (.@first+14 < .@count ? .@first+14 : .@count);
		.@menu$ = "";
		for (.@n = .@first; .@n < .@last; ++.@n) {
			.@id = $@GRO_AdminKeyID[.@n];
			.@menu$ += $@GRO_Map$[.@id] + ":";
		}
		.@menu$ += "Previous Page:Next Page:Cancel";
		mes "[GM / Map Registry]";
		mes "Alphabetical maps "+(.@first+1)+"-"+.@last+" of "+.@count;
		.@pick = select(.@menu$);
		.@shown = .@last - .@first;
		if (.@pick <= .@shown) return $@GRO_AdminKeyID[.@first+.@pick-1];
		if (.@pick == .@shown+1 && .@page > 0) --.@page;
		else if (.@pick == .@shown+2 && .@last < .@count) ++.@page;
		else if (.@pick == .@shown+3) return 0;
		clear;
	}
}


function	script	GRO_AdminMap	{
	clear;
	if (getgmlevel() < 99) return;
	.@entry = select("Browse maps alphabetically:Exact map-name search:Cancel");
	if (.@entry == 3) return;
	if (.@entry == 1) {
		.@id = callfunc("GRO_ChooseMap");
		if (!.@id) return;
		.@search$ = $@GRO_Map$[.@id];
	} else {
		mes "Enter an exact registered map name (example: gef_fild13).";
		input .@search$;
		.@id = 0;
		for (.@i = 1; .@i <= $@GRO_Count; ++.@i) {
			if ($@GRO_Map$[.@i] == .@search$) { .@id = .@i; break; }
		}
		if (!.@id) { mes "This map is not in the predefined registry."; return; }
	}
	.@key = $@GRO_Key[.@id];
	while (1) {
		clear;
		if (getgmlevel() < 99) return;
		mes "[GM / " + $@GRO_Map$[.@id] + "]";
		mes "Selected arrival: " + $@GRO_Name$[.@id] + " (ID " + .@id + ")";
		mes "Policy: "+$GRO_Policy[.@key]+" (0 inherit, 1 allowed, 2 restricted, 3 GM only)";
		mes "MVP designation: "+$GRO_MvpMap[.@key];
		mes "Location: "+($GRO_XSet[.@id] ? $GRO_CustomX[.@id] : $@GRO_X[.@id])+","+($GRO_XSet[.@id] ? $GRO_CustomY[.@id] : $@GRO_Y[.@id]);
		mes "Fee override: "+($GRO_FeeSet[.@key] ? $GRO_MapFee[.@key]+"z" : "off");
		.@pick = select("Set map policy:Edit arrival coordinates:Restore arrival coordinates:Set/clear map fee override:Toggle MVP classification:Toggle collection eligibility:Set Strange Poring fixed location:Select another arrival on this map:Back");
		if (.@pick == 9) return;
		if (getgmlevel() < 99) return;
		if (.@pick == 1) {
			.@new = select("Inherit Global:Allowed:Restricted:GM Only:Cancel") - 1;
			if (.@new == 4) continue;
			.@old = $GRO_Policy[.@key];
			if (.@new == .@old) continue;
			mes "Change map policy from "+.@old+" to "+.@new+"?";
			if (.@new == 1 && $GRO_MvpMap[.@key] && !$GRO_MvpAllow) mes "^FF5555WARNING: Allowed overrides the global MVP warp block for this map.^000000";
			if (select("Confirm critical change:Cancel") != 1) continue;
			$GRO_Policy[.@key] = .@new;
			callfunc "GRO_LogGM","MAP_POLICY map="+.@search$+" old="+.@old+" new="+.@new;
			callfunc "GRO_Refresh";
		}
		else if (.@pick == 2) {
			mes "Enter X (1-600):";
			input .@x,1,600;
			mes "Enter Y (1-600):";
			input .@y,1,600;
			if (mapname2id(.@search$) < 0 || !checkcell(.@search$,.@x,.@y,cell_chkpass)) {
				mes "Invalid/unloaded map or blocked arrival cell. No changes made.";
				continue;
			}
			.@old$ = ($GRO_XSet[.@id] ? $GRO_CustomX[.@id]+","+$GRO_CustomY[.@id] : $@GRO_X[.@id]+","+$@GRO_Y[.@id]);
			$GRO_CustomX[.@id] = .@x;
			$GRO_CustomY[.@id] = .@y;
			$GRO_XSet[.@id] = 1;
			callfunc "GRO_LogGM","COORD map="+.@search$+" id="+.@id+" old="+.@old$+" new="+.@x+","+.@y;
		}
		else if (.@pick == 3) {
			$GRO_XSet[.@id] = 0;
			callfunc "GRO_LogGM","COORD_RESTORE map="+.@search$+" id="+.@id;
		}
		else if (.@pick == 4) {
			.@p = select("Set override:Remove override:Cancel");
			if (.@p == 1) {
				mes "Enter custom Zeny price (0-100000000):";
				input .@value,0,100000000;
				.@old = ($GRO_FeeSet[.@key] ? $GRO_MapFee[.@key] : -1);
				$GRO_MapFee[.@key] = .@value;
				$GRO_FeeSet[.@key] = 1;
				callfunc "GRO_LogGM","FEE_MAP map="+.@search$+" old="+.@old+" new="+.@value;
			} else if (.@p == 2) {
				$GRO_FeeSet[.@key] = 0;
				callfunc "GRO_LogGM","FEE_MAP_RESET map="+.@search$;
			}
		}
		else if (.@pick == 5) {
			mes "Change whether this map is treated as MVP-protected?";
			if (select("Confirm:Cancel") != 1) continue;
			.@old = $GRO_MvpMap[.@key];
			$GRO_MvpMap[.@key] = !.@old;
			callfunc "GRO_LogGM","MVP_MAP map="+.@search$+" old="+.@old+" new="+$GRO_MvpMap[.@key];
			callfunc "GRO_Refresh";
		}
		else if (.@pick == 6) {
			if ($@GRO_Cat[.@id] != 3) { mes "Only dungeon-floor entries count toward collection."; continue; }
			mes "Permanent catalog inclusion determines the collection denominator. Progress is never erased.";
			if (select("Confirm toggle:Cancel") != 1) continue;
			$GRO_CollectionExcluded[.@id] = !$GRO_CollectionExcluded[.@id];
			callfunc "GRO_LogGM","COLLECTION_CATALOG id="+.@id+" map="+.@search$+" excluded="+$GRO_CollectionExcluded[.@id];
		}
		else if (.@pick == 7) {
			if ($@GRO_Cat[.@id] != 3) { mes "Only dungeon floors have Strange Porings."; continue; }
			mes "Enter fixed discovery NPC X (1-600):";
			input .@x,1,600;
			mes "Enter fixed discovery NPC Y (1-600):";
			input .@y,1,600;
			if (mapname2id(.@search$) < 0 || !checkcell(.@search$,.@x,.@y,cell_chkpass)) {
				mes "Invalid NPC cell. Not saved.";
				continue;
			}
			$GRO_FixedX[.@id] = .@x;
			$GRO_FixedY[.@id] = .@y;
			$GRO_FixedSet[.@id] = 1;
			$GRO_PoringX[.@id] = .@x;
			$GRO_PoringY[.@id] = .@y;
			$GRO_PoringDay[.@id] = (gettimetick(2)+28800)/86400;
			callfunc "GRO_LogGM","PORING_FIXED id="+.@id+" map="+.@search$+" new="+.@x+","+.@y;
			callfunc "GRO_Refresh";
		}
		else if (.@pick == 8) {
			.@choices$ = "";
			.@total = 0;
			for (.@j=1; .@j<=$@GRO_Count; ++.@j) {
				if ($@GRO_Map$[.@j] != .@search$) continue;
				@GRO_ArrivalIDs[.@total++] = .@j;
				.@choices$ += $@GRO_Name$[.@j] + ":";
			}
