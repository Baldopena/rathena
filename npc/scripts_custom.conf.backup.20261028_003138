function	script	GRO_AdminRewards	{
	if (getgmlevel() < 99) return;
	while (1) {
		clear;
		mes "[GM / Collection Rewards]";
		mes "Published versions: "+$GRO_RewardCount;
		mes "CLAIMING IS LOCKED in Phase 1 under D-01.";
		mes "Draft: "+$GRO_DraftName$+" item="+$GRO_DraftItem+" x"+$GRO_DraftQty+" zeny="+$GRO_DraftZeny;
		mes "Previous claimants eligible by default: "+$GRO_DraftOldEligible;
		.@pick = select("Set draft name:Set item ID:Set item amount:Set Zeny:Set up to 3 special warp IDs:Toggle previous-claimant eligibility:Publish new version:Archive published version:Back");
		if (.@pick == 9 || getgmlevel() < 99) return;
		if (.@pick == 1) {
			mes "Draft display name (no colon):";
			input .@name$;
			$GRO_DraftName$ = .@name$;
		}
		else if (.@pick == 2) { mes "Enter item ID (0=none):"; input $GRO_DraftItem,0,1000000; }
		else if (.@pick == 3) { mes "Enter item amount (0=none):"; input $GRO_DraftQty,0,10000; }
		else if (.@pick == 4) { mes "Enter reward Zeny (0-100000000):"; input $GRO_DraftZeny,0,100000000; }
		else if (.@pick == 5) {
			for (.@j = 0; .@j < 3; ++.@j) {
				mes "Special warp slot "+(.@j+1)+": enter destination ID (0=none).";
				input .@id,0,$@GRO_Count;
				$GRO_DraftSpecial[.@j] = .@id;
			}
		}
		else if (.@pick == 6) $GRO_DraftOldEligible = !$GRO_DraftOldEligible;
		else if (.@pick == 7) {
			if ($GRO_RewardCount >= 16) { mes "Maximum 16 published versions. No changes made."; continue; }
			mes "Publish immutable reward version "+($GRO_RewardCount+1)+"? Actual claims remain DISABLED.";
			if (select("Confirm publishing:Cancel") != 1) continue;
			$GRO_RewardCount += 1;
			.@v = $GRO_RewardCount;
			$GRO_RewardName$[.@v] = $GRO_DraftName$;
			$GRO_RewardItem[.@v] = $GRO_DraftItem;
			$GRO_RewardQty[.@v] = $GRO_DraftQty;
			$GRO_RewardZeny[.@v] = $GRO_DraftZeny;
			$GRO_RewardOldEligible[.@v] = $GRO_DraftOldEligible;
			for (.@k=0; .@k<3; ++.@k) $GRO_RewardSpecial[.@v*3+.@k] = $GRO_DraftSpecial[.@k];
			$GRO_RewardArchived[.@v] = 0;
			callfunc "GRO_LogGM","REWARD_PUBLISH version="+.@v+" item="+$GRO_DraftItem+" qty="+$GRO_DraftQty+" zeny="+$GRO_DraftZeny+" old_eligible="+$GRO_DraftOldEligible;
		}
		else if (.@pick == 8) {
			if (!$GRO_RewardCount) { mes "There are no published versions."; continue; }
			mes "Enter version to archive (1-"+$GRO_RewardCount+"):";
			input .@v,1,$GRO_RewardCount;
			if ($GRO_RewardArchived[.@v]) { mes "Already archived."; continue; }
			mes "Archive version "+.@v+"? Its historical definition is retained.";
			if (select("Confirm archive:Cancel") != 1) continue;
			$GRO_RewardArchived[.@v] = 1;
			callfunc "GRO_LogGM","REWARD_ARCHIVE version="+.@v;
		}
		if (.@pick >= 1 && .@pick <= 6) callfunc "GRO_LogGM","REWARD_DRAFT_EDIT field="+.@pick;
		clear;
	}
}

