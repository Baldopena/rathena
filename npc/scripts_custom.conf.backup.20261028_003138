function	script	GRO_AdminReset	{
	clear;
	if (getgmlevel() < 99) return;
	mes "[GM / Configuration Recovery]";
	mes "All reset options PRESERVE account discoveries, earned privileges, and reward claim history.";
	.@pick = select("Reset individual general setting:Reset general settings category:Reset map settings category:FULL configuration reset:Back");
	if (.@pick == 5 || getgmlevel() < 99) return;
	if (.@pick == 1) {
		.@which = select("Global MVP allow:Castle-ground WoE protection:Discovery bypass:Randomization:Pricing enabled:Player counts:Restricted map listings:Main sprite:Strange Poring sprite:Cancel");
		if (.@which == 10) return;
		mes "Restore selected general setting to its soft-release default?";
		if (select("Confirm:Cancel") != 1) return;
		switch (.@which) {
			case 1: $GRO_MvpAllow=1; break;
			case 2: $GRO_WoeCastleAllow=0; break;
			case 3: $GRO_DiscoveryBypass=1; break;
			case 4: $GRO_Randomize=0; break;
			case 5: $GRO_Pricing=0; break;
			case 6: $GRO_ShowCounts=1; break;
			case 7: $GRO_ShowRestricted=1; break;
			case 8: $GRO_MainSprite=113; break;
			case 9: $GRO_PoringSprite=508; break;
		}
		callfunc "GRO_LogGM","RESET_INDIVIDUAL general="+.@which;
	} else if (.@pick == 2) {
		.@category = select("World rules (MVP and WoE):Discovery controls:Warp pricing and category fees:Display and sprites:All general settings:Cancel");
		if (.@category == 6) return;
		mes "Restore selected settings category to soft-release defaults?";
		if (.@category == 1 || .@category == 2 || .@category == 5) mes "^FF5555WARNING: Resetting may reopen MVP maps or re-enable discovery bypass.^000000";
		if (select("Confirm category reset:Cancel") != 1) return;
		switch (.@category) {
			case 1: $GRO_MvpAllow=1; $GRO_WoeCastleAllow=0; break;
			case 2: $GRO_DiscoveryBypass=1; $GRO_Randomize=0; $GRO_PoringSprite=508; break;
			case 3:
				$GRO_Pricing=0; $GRO_TownFee=0; $GRO_FieldFee=0;
				$GRO_DungeonFee=0; $GRO_DepthFee=0; $GRO_CastleFee=0; $GRO_GuildFee=0;
				break;
			case 4: $GRO_ShowCounts=1; $GRO_ShowRestricted=1; $GRO_MainSprite=113; $GRO_PoringSprite=508; break;
			case 5: callfunc "GRO_ResetGeneral"; break;
		}
		callfunc "GRO_LogGM","RESET_CATEGORY general_section="+.@category;
	} else if (.@pick == 3) {
		mes "This restores all per-map policies, coordinates, fees, catalog exclusions and MVP classifications to predefined defaults.";
		if (select("Confirm category reset:Cancel") != 1) return;
		callfunc "GRO_ResetMaps";
		callfunc "GRO_LogGM","RESET_CATEGORY maps";
	} else {
		mes "^FF5555FULL RESET WARNING^000000";
		mes "Will restore ALL global and per-map GM configuration to soft-release defaults.";
		mes "MVP direct warps will be allowed; discovery bypass will be ON; fees will be FREE.";
		mes "Preserves: account discoveries, existing reward version definitions, archives, and reward histories.";
		if (select("CONFIRM FULL CONFIG RESET:Cancel") != 1) return;
		callfunc "GRO_ResetGeneral";
		callfunc "GRO_ResetMaps";
		callfunc "GRO_LogGM","RESET_FULL settings_only";
	}
	callfunc "GRO_Refresh";
	mes "Configuration reset complete.";
	return;
}

